#!/usr/bin/make -f
# KubeOS dashboard packaging.
#
# WHY  package the RELEASE ARCHIVE instead of rebuilding it: this is the exact artefact that is
#      booted and verified in the ISO, so what the package ships and what was tested are the same
#      bytes by construction. Building it here from source instead meant trusting a branch - and on
#      2026-11-19 that shipped the `main` branch, which is behind `dev`, silently dropping the
#      rebalance feature and the etcd-snapshot fix.
%:
	dh $@

override_dh_auto_build:
	@echo "kubeos-dashboard: shipping vendor/release, nothing is rebuilt"

# The payload goes exactly where the ISO put it: kubeos-dashboard-install (in kubeos-cli) reads
# RELEASE, verifies SHA256 and unpacks the tarball into this directory.
override_dh_auto_install:
	install -d -m 0755 debian/kubeos-dashboard/usr/share/kubeos/dashboard
	install -m 0644 vendor/release/*.tar.gz debian/kubeos-dashboard/usr/share/kubeos/dashboard/
	install -m 0644 vendor/release/RELEASE   debian/kubeos-dashboard/usr/share/kubeos/dashboard/RELEASE
	install -m 0644 vendor/release/SHA256    debian/kubeos-dashboard/usr/share/kubeos/dashboard/SHA256
	# prove at build time that the artefact matches the checksum shipped next to it
	set -e; cd debian/kubeos-dashboard/usr/share/kubeos/dashboard && sha256sum -c SHA256

# Nothing under /etc: no conffiles (D5).
override_dh_installdeb:
	dh_installdeb
	: > debian/kubeos-dashboard/DEBIAN/conffiles
