# Flags for kubeos-dashboard.service. `install.sh` writes the real file to
# /etc/default/kubeos-dashboard; this example documents every option it sets.
#
# One single line, no quoting: systemd splits $HEADLAMP_ARGS on whitespace.
HEADLAMP_ARGS=--kubeconfig=/etc/kubeos-dashboard/kubeconfig --html-static-dir=/usr/share/kubeos-dashboard/frontend --plugins-dir=/usr/share/kubeos-dashboard/plugins --listen-addr=0.0.0.0 --port=30443 --tls-cert-path=/etc/kubeos-dashboard/tls.crt --tls-key-path=/etc/kubeos-dashboard/tls.key --app-name=KubeOS --watch-plugins-changes=false --allow-kubeconfig-changes=false --log-level=info
